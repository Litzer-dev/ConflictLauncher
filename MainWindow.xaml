<Window x:Class="ConflictLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conflict: Global Terror — SquadMod Launcher"
        Width="740"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">

    <Border Margin="14" CornerRadius="14" Background="{StaticResource BgShell}"
            BorderBrush="#2A3548" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.65"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Draggable Title Bar -->
            <Border Grid.Row="0" Background="#0B0E14" CornerRadius="14,14,0,0"
                    BorderBrush="#1E2736" BorderThickness="0,0,0,1"
                    Padding="16,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tactical Crosshair Emblem -->
                        <Grid Width="20" Height="20" Margin="0,0,10,0">
                            <Ellipse Stroke="#F59E0B" StrokeThickness="1.6"/>
                            <Ellipse Width="6" Height="6" Fill="#F59E0B"/>
                            <Line X1="10" Y1="0" X2="10" Y2="5" Stroke="#F59E0B" StrokeThickness="1.5"/>
                            <Line X1="10" Y1="15" X2="10" Y2="20" Stroke="#F59E0B" StrokeThickness="1.5"/>
                            <Line X1="0" Y1="10" X2="5" Y2="10" Stroke="#F59E0B" StrokeThickness="1.5"/>
                            <Line X1="15" Y1="10" X2="20" Y2="10" Stroke="#F59E0B" StrokeThickness="1.5"/>
                        </Grid>
                        <TextBlock Text="CONFLICT LAUNCHER" FontSize="11.5" FontWeight="Bold"
                                   Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="SQUADMOD EDITION" FontSize="9.5" FontWeight="Bold"
                                       Foreground="#FBBF24"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Style="{StaticResource ChromeButton}"
                                FontSize="12" FontWeight="Bold" Click="MinimizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseChromeButton}"
                                FontSize="12" Margin="4,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tactical Hero Banner -->
            <Border Grid.Row="1" Padding="24,20" BorderBrush="#1E2736" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#161E2B" Offset="0"/>
                        <GradientStop Color="#1C1917" Offset="0.65"/>
                        <GradientStop Color="#2A1C0E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Decorative Tactical Chevrons -->
                    <Canvas HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" Height="80" Opacity="0.14">
                        <Path Data="M 20,10 L 55,40 L 20,70" Stroke="#F59E0B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 55,10 L 90,40 L 55,70" Stroke="#F59E0B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 90,10 L 125,40 L 90,70" Stroke="#F59E0B" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#292014" BorderBrush="#92400E" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="4-PLAYER CO-OP + AI SQUAD" FontSize="10" FontWeight="Bold"
                                           Foreground="#FBBF24"/>
                            </Border>
                            <Border Background="#0F2922" BorderBrush="#065F46" BorderThickness="1"
                                    CornerRadius="4" Padding="8,3">
                                <TextBlock Text="STEAM VIRTUAL LAN" FontSize="10" FontWeight="Bold"
                                           Foreground="#34D399"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="CONFLICT: GLOBAL TERROR"
                                   FontSize="26" FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="One-click automated download, silent repack setup, dgVoodoo graphics &amp; SquadMod."
                                   FontSize="12.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <StackPanel Grid.Row="2" Margin="22,18,22,14">

                <!-- Install Location Card -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="INSTALL LOCATION" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPathBox" Grid.Column="0"
                                     Background="#0B0E14" Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="#283447" BorderThickness="1"
                                     Padding="11,8" FontSize="13" VerticalContentAlignment="Center"
                                     TextChanged="InstallPathBox_TextChanged"/>
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..."
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status & Options Card -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SYSTEM &amp; DEPLOYMENT STATUS" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="Game Files:" Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
                            <TextBlock x:Name="GameStatusText" Grid.Column="2" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ModStatusDot" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="SquadMod + dgVoodoo:" Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
                            <TextBlock x:Name="ModStatusText" Grid.Column="2" FontSize="12.5" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="DirectPlayStatusDot" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="Windows DirectPlay:" Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DirectPlayStatusText" Grid.Column="2" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="EnableDirectPlayButton" Grid.Column="3" Content="Enable DirectPlay"
                                    Style="{StaticResource SecondaryButton}" Padding="10,4"
                                    Visibility="Collapsed" Click="EnableDirectPlayButton_Click"/>
                        </Grid>

                        <!-- Co-op Options -->
                        <StackPanel x:Name="ModOptionsPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Border Height="1" Background="#222C3C" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SteamModeCheckBox" Grid.Column="0"
                                          Content="Play Co-op over Steam (Virtual LAN)"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="SteamModeCheckBox_Changed"
                                          Unchecked="SteamModeCheckBox_Changed"/>
                                <Button x:Name="UpdateModButton" Grid.Column="1" Content="Update Mod"
                                        Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="8,0,0,0"
                                        Foreground="#FBBF24" BorderBrush="#92400E"
                                        Visibility="Collapsed" Click="UpdateModButton_Click"/>
                                <Button x:Name="ReinstallModButton" Grid.Column="2" Content="Reinstall Mod"
                                        Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="8,0,0,0"
                                        Click="ReinstallModButton_Click"/>
                                <Button x:Name="OpenFolderButton" Grid.Column="3" Content="Open Folder"
                                        Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="8,0,0,0"
                                        Click="OpenFolderButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4-Step Pipeline + Progress Card -->
                <Border Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="15">
                    <StackPanel>
                        <!-- 4-Step Pills -->
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border x:Name="Step1Pill" Background="#1A222E" BorderBrush="#2A3649" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,6,0">
                                <TextBlock x:Name="Step1Label" Text="1. DOWNLOAD" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#64748B"/>
                            </Border>
                            <Border x:Name="Step2Pill" Background="#1A222E" BorderBrush="#2A3649" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,6,0">
                                <TextBlock x:Name="Step2Label" Text="2. EXTRACT" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#64748B"/>
                            </Border>
                            <Border x:Name="Step3Pill" Background="#1A222E" BorderBrush="#2A3649" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,0,6,0">
                                <TextBlock x:Name="Step3Label" Text="3. INSTALL" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#64748B"/>
                            </Border>
                            <Border x:Name="Step4Pill" Background="#1A222E" BorderBrush="#2A3649" BorderThickness="1" CornerRadius="5" Padding="6,4">
                                <TextBlock x:Name="Step4Label" Text="4. SQUADMOD" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#64748B"/>
                            </Border>
                        </UniformGrid>

                        <TextBlock x:Name="StepText"
                                   Text="Ready. Choose an install folder and click Install to begin."
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>

                        <ProgressBar x:Name="MainProgressBar"
                                     Style="{StaticResource TacticalProgressBar}"
                                     Minimum="0" Maximum="100" Value="0"
                                     Margin="0,0,0,8"/>

                        <TextBlock x:Name="ProgressDetailText"
                                   Text="Downloads ~1.6 GB repack, extracts, runs silent setup, and installs SquadMod."
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer Actions -->
            <Border Grid.Row="3" Background="#0B0E14" CornerRadius="0,0,14,14"
                    BorderBrush="#1E2736" BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrimaryActionButton" Grid.Column="0"
                                Content="DOWNLOAD &amp; INSTALL GAME + SQUADMOD"
                                Style="{StaticResource PrimaryButton}"
                                Click="PrimaryActionButton_Click"/>

                        <Button x:Name="CancelButton" Grid.Column="1"
                                Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Visibility="Collapsed"
                                Click="CancelButton_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               Text="Co-op Tip: Start Steam first • Host presses F7 (or OPTIONS &gt; STEAM) to invite • MULTIPLAYER &gt; STEAM CO-OP"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
